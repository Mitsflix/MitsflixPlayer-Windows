{
  "name": "mitsflix-player",
  "productName": "Mitsflix Player",
  "version": "1.4.0",
  "description": "Mitsflix Player for Windows and Linux \u2014 live TV, movies and series from any IPTV playlist.",
  "author": {
    "name": "Mitsflix",
    "email": "sales@mitsflix.com"
  },
  "homepage": "https://mitsflix.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "hls.js": "^1.6.2",
    "mpegts.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mitsflix.player.windows",
    "productName": "Mitsflix Player",
    "copyright": "Mitsflix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "downloads.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MitsflixPlayer-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mitsflix Player",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Mitsflix",
        "repo": "MitsflixPlayer-Windows",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "mitsflix-player",
      "artifactName": "MitsflixPlayer.${ext}",
      "synopsis": "Live TV, movies and series from your IPTV playlist",
      "maintainer": "Mitsflix <sales@mitsflix.com>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "MitsflixPlayer-mac.${ext}"
    },
    "dmg": {
      "title": "Mitsflix Player",
      "artifactName": "MitsflixPlayer.dmg"
    }
  }
}
